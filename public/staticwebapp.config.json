{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/icons/*", "/manifest.webmanifest", "/sw.js"]
  },
  "mimeTypes": { ".webmanifest": "application/manifest+json" },
  "routes": [
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/receipt", "allowedRoles": ["authenticated"] },
    { "route": "/receipts", "allowedRoles": ["authenticated"] },
    { "route": "/dashboard", "allowedRoles": ["authenticated"] },
    { "route": "/manifest.webmanifest", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache" } }
  ]
}
